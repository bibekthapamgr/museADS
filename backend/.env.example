# Copy to .env and fill in your Meta app credentials.
# Alternative: skip this file entirely and enter the same values in the
# dashboard's Settings page — they're stored in the backend database and
# take precedence over these variables.
APP_ID=
APP_SECRET=
REDIRECT_URI=http://localhost:5000/auth/callback

# Random string you invent; must match what you enter in the Webhooks dashboard.
WEBHOOK_VERIFY_TOKEN=change-me

# Optional: separate secret used only for webhook signature verification.
# Defaults to APP_SECRET when empty.
APP_SECRET_FOR_SIGNATURE=

PORT=5000
GRAPH_VERSION=v21.0
